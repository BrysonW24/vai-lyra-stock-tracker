# =============================================================================
# Lyra - Stock Momentum Radar - environment
# Copy this file to .env.local and fill in only what you need.
#
# THREE MODES (copy only as much as you want):
#   1. Demo mode  - NO keys. The app runs on built-in demo data. Just `npm run dev`.
#   2. Live mode  - Supabase + a market-data source + (optional) Telegram for real
#                   scanning and alerts.
#   3. AI mode    - add OPENAI_API_KEY for the hosted beta default. Users can still BYOK.
#
# Never commit .env.local. Never put SUPABASE_SERVICE_ROLE_KEY or any token in a
# NEXT_PUBLIC_* variable - those are exposed to the browser. See SECURITY.md.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3042
# Demo fallback is automatic: the dashboard shows built-in demo data whenever the
# Supabase env vars below are absent. There is no flag to toggle it.

# --- Frontend: read-only Supabase access (safe to expose) --------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Worker-only secrets (NEVER expose through the frontend) -----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the paper-bot approval capability (propose -> approve -> execute). The gate is unforgeable
# with or without this (a per-process key is used when unset), but setting a stable server secret
# makes the capability durable across serverless instances. Falls back to SUPABASE_SERVICE_ROLE_KEY /
# NOTIFICATION_DISPATCH_SECRET / AUTH_SECRET when blank. Keep server-only; never NEXT_PUBLIC.
PAPER_BOT_INTENT_SECRET=

# Multi-user: in single-operator mode, set this to your profiles.id (auth user uuid)
# so the worker stamps overlays with your user id and they show up under RLS. Leave
# blank for legacy single-operator (overlays written with null user_id).
DEFAULT_USER_ID=

# --- Telegram alerts (optional - needed only to receive alerts) --------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Separate chat for paper-bot flags (approvals, fills); falls back unset = no bot channel.
TELEGRAM_PAPER_CHAT_ID=

# --- Web Push notifications --------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@vivacity.ai

# Worker/server dispatch path for scanner notifications. In production set
# APP_BASE_URL=https://your-vercel-domain and a strong NOTIFICATION_DISPATCH_SECRET.
APP_BASE_URL=http://localhost:3042
NOTIFICATION_DISPATCH_URL=
NOTIFICATION_DISPATCH_SECRET=

# --- Redis cache (optional, server-side ONLY) --------------------------------
# Caches market quotes + other hot reads. Without these the app uses a safe
# in-process cache - Redis is an optimisation, never a requirement.
# Vercel: add the "Upstash for Redis" marketplace integration (it injects these);
# Coolify: add a Redis service, or use any Upstash REST-compatible endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV names are also accepted: KV_REST_API_URL / KV_REST_API_TOKEN.

# --- Error monitoring (Sentry, optional) -------------------------------------
# With a DSN set, client + server errors and traces report to Sentry. Unset = a
# complete no-op, so demo, self-host, and forks of this repo never report.
# The DSN is a public ingestion key (safe to expose); set it in Vercel/host env.
NEXT_PUBLIC_SENTRY_DSN=
# Server + edge may use an unprefixed DSN; falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# Build-time ONLY - uploads source maps so prod stack traces are readable. Set it
# in Vercel/CI env; never commit it (the wizard's .env.sentry-build-plugin is gitignored).
# SENTRY_AUTH_TOKEN=

# --- Market data -------------------------------------------------------------
MARKET_DATA_PROVIDER=yfinance
TICKER_SYMBOLS=
DEFAULT_TIMEFRAME=1h
LOOKBACK_PERIOD_DAYS=180

# --- Scanner thresholds ------------------------------------------------------
ALERT_SCORE_THRESHOLD=75
WATCHLIST_SCORE_THRESHOLD=60
SIGNAL_CHANGE_THRESHOLD=8

# --- Scanner toggles ---------------------------------------------------------
ENABLE_TELEGRAM_ALERTS=true
ENABLE_WATCHLIST_ALERTS=false
ENABLE_HOURLY_DIGEST=false
# Scan only during the US session (9:00-17:30 New York). Leave it FALSE on a deployment whose
# dashboard is watched outside US hours: the app marks a scan older than 2h as stale and shows a
# guard-skipped run as a failed one, so the header would read red all through the closed market.
ENABLE_MARKET_HOURS_GUARD=true
FORCE_SCAN=false

# --- Optional: Horizon-2 live data (free Finnhub tier) -----------------------
# Lights up live news / fundamentals / earnings + IPO calendar when present.
# Also feeds the scout worker's broad general-news stream.
FINNHUB_API_KEY=

# --- Optional: Scout crawl targets (Firecrawl hosted API) --------------------
# Activates the registered crawl sources in content/scout-sources.jsonl (pages
# with high signal but no RSS, e.g. the DoD daily contract announcements).
# Without it the scout still runs on the open RSS + Finnhub layers.
FIRECRAWL_API_KEY=

# --- Founder-only surfaces (server-side ONLY) --------------------------------
# Comma-separated account emails allowed to read founder-facing internal data
# (e.g. GET /api/ai/insights, which aggregates other users' question text). In a
# configured deploy this route FAILS CLOSED when unset - set your own email here.
FOUNDER_EMAILS=

# --- Optional: hosted AI beta (server-side ONLY) ----------------------------
# Powers keyless beta chat/briefs. Browser BYOK still overrides this per user.
OPENAI_API_KEY=
LYRA_HOSTED_OPENAI_MODEL=gpt-5.5
LYRA_OPENAI_REASONING_EFFORT=low

# Optional older shared free-tier fallback for Google Gemini.
GOOGLE_AI_KEY=
# Model pin for the shared Google key (server-side; client model choices are ignored on it).
LYRA_SHARED_GOOGLE_MODEL=

# Hosted-key spend backstop (tokens): per-completion ceiling and per-UTC-day ceiling across
# all users of the hosted/shared keys. The day counter is shared through Redis when the cache
# env above is set (one budget for every serverless instance), in-process otherwise. BYOK is
# never budgeted. Defaults: 2000 per run, 250000 per day. Raise/lower to taste.
LYRA_HOSTED_TOKENS_PER_RUN=
LYRA_HOSTED_TOKENS_PER_DAY=

# Who keeps the hosted key after the 14-day trial: a comma-separated list of account emails.
# This is the ONLY standing grant - set your own email here or your account lapses to
# bring-your-own-key two weeks after signup. (A profiles.ai_included column exists but is
# deliberately not read: a user can write their own profile row. See src/lib/ai/entitlement.ts.)
AI_INCLUDED_EMAILS=

# Frontend flag: advertise the keyless free-AI beta in the UI (client-visible).
NEXT_PUBLIC_LYRA_FREE_AI=

# Feature control (client-visible): arm the Solo -> account upgrade CTA. Set to 1 ONLY on a Solo
# deployment to show a "create a free Community account" prompt where Solo cannot deliver (background
# notifications). Off/unset = the prompt stays dark. No effect on the accounted build.
NEXT_PUBLIC_SOLO_UPGRADE_CTA=

# Optional worker-side AI explanations / legacy smart-money paths.
ANTHROPIC_API_KEY=
ENABLE_AI_EXPLANATIONS=false

# --- Community ideas board (server-side ONLY, optional) -----------------------
# Signs the no-account participant key (post + vote without signing in). Falls back to
# AUTH_SECRET, then SUPABASE_SERVICE_ROLE_KEY; set a dedicated value to keep those separate.
COMMUNITY_KEY_SECRET=

# --- Emerging Winner Engine (worker-side, all optional) -----------------------
# 1 = scan the real listed universe and append scored candidates to the immutable ledger
# (needs migrations 056 + 057). Anything else = score a small illustrative set and persist
# NOTHING - invented candidates are never written to the ledger.
EW_REAL_UNIVERSE=0
EW_UNIVERSE_LIMIT=300
EW_MARKETS=us,au
# SEC EDGAR requires a declared User-Agent with a contact address ("Name contact@example.com")
# and blocks clients that do not send one. USAspending asks for the same courtesy.
SEC_USER_AGENT=
USASPENDING_USER_AGENT=

# --- Direct database URL (read-only gates, never the frontend) ----------------
# Postgres connection string (Supabase: Project Settings -> Database -> Connection pooler).
# Used by `npm run check:schema-drift` and `npm run check:data-economics` to compare the live
# database with the migrations and the size budgets. The nightly workflow passes it as a secret.
SUPABASE_POOLER_URL=

# --- GitHub Actions failure paging (repository secrets, not app env) ----------
# Set these as GitHub repository secrets, not here: every workflow pages them when it fails.
# With none set a failure reaches nobody (the run then carries a visible warning saying so).
# Kept separate from TELEGRAM_* on purpose - those also arm the scanner's own alert path.
#   OPS_TELEGRAM_BOT_TOKEN   OPS_TELEGRAM_CHAT_ID   OPS_SLACK_WEBHOOK_URL

# --- In-app feedback channel (server-side ONLY, all optional) ----------------
# The in-app feedback box (floating launcher, plus the 2-week rating prompt) fans
# out to every sink configured here.
# With none set, feedback only reaches the server logs - wire at least one.
# GitHub sink: fine-grained PAT with Issues write on the repo below. Whatever a user types is
# filed as an issue there - if that repository is public, so is their feedback (the sender's
# email is never included; it goes to the Slack sink only). Point this at a private repo, or
# leave it unset and use Slack alone.
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=
# Slack sink, simplest: an incoming webhook URL pointed at your feedback channel.
SLACK_FEEDBACK_WEBHOOK_URL=
# Slack sink, alternative: a bot token (xoxb-, needs chat:write + invited to the
# channel) + the channel id (e.g. C0BH9L1M6KZ = #lyra feedback in the VD workspace).
SLACK_FEEDBACK_BOT_TOKEN=
SLACK_FEEDBACK_CHANNEL=

# --- Release announcements (server-side ONLY, all optional) ------------------
# `npm run announce` (run AFTER release + commit + push) posts RELEASES[0] to every
# configured channel. Slack falls back to SLACK_FEEDBACK_WEBHOOK_URL; Telegram falls
# back to TELEGRAM_CHAT_ID; WhatsApp needs the WHATSAPP_* trio above plus a recipient
# (and realistically an approved template - Meta gates business-initiated sends).
SLACK_UPDATES_WEBHOOK_URL=
TELEGRAM_UPDATES_CHAT_ID=
WHATSAPP_UPDATES_TO=

# --- Telegram webhook security (Part 8) -----------------------------------
# Secret token set when registering the webhook; Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header and the route rejects mismatches.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Part 9 - architecture only, server-side ONLY) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
