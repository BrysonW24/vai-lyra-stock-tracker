# Keep the Docker build context lean. The image needs: package.json + lockfile,
# src/, public/, content/, scripts/, next.config.js, tsconfig.json, tailwind/postcss
# configs, middleware source. Everything below is not part of the web build.

node_modules
.next
.git
.githooks
.github
.vscode

# Local env + logs - secrets never enter the image; config arrives via build args / runtime env.
.env*
!.env.example
*.log

# Python scanner worker (runs on GitHub Actions, not in this image) + its tests.
workers
tests
.pytest_cache
__pycache__
.venv

# Database schema/migrations are applied to Supabase directly, not baked into the image.
sql
supabase

# Docs and repo media (README screenshots etc.). `contracts/` is NOT ignored: the app imports
# JSON from it at build time (the guardrail wording in src/lib/ai/guardrails/engine.ts, the
# feedback contract in the Telegram webhook), so an image built without it fails to compile.
docs
*.md
image*.png

# Build/verification scratch.
coverage
.turbo
.next-*
