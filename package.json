{
  "name": "vai-lyra-stock-tracker",
  "version": "0.61.0",
  "private": true,
  "description": "Hourly tech stock momentum scanner dashboard and Python worker.",
  "scripts": {
    "dev": "node scripts/splash.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "test": "TZ=UTC vitest run",
    "worker:scan": "node scripts/py.mjs -m workers.stock_scanner.main",
    "worker:outcomes": "node scripts/py.mjs -m workers.stock_scanner.outcome_job",
    "worker:scout": "node scripts/py.mjs -m workers.scout.main",
    "scout:queue": "node scripts/scout-queue.mjs",
    "check:ledgers": "node scripts/check-ledgers.mjs",
    "worker:digest": "node scripts/py.mjs -m workers.stock_scanner.digest_job",
    "worker:test": "node scripts/py.mjs -m pytest tests",
    "train:recovery": "node scripts/py.mjs -m workers.stock_scanner.ml.recovery_model",
    "content:build": "node scripts/build-content.mjs",
    "commission": "node scripts/commission-card.mjs",
    "release": "node scripts/release.mjs",
    "announce": "node scripts/announce-release.mjs",
    "check:version": "node scripts/check-version-bump.mjs",
    "predev": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "pretype-check": "node scripts/build-content.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:onboarding": "node scripts/check-onboarding-parity.mjs",
    "check:onboarding-contract": "node scripts/check-onboarding-contract.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:deploy": "node scripts/check-deploy-health.mjs",
    "check:chains": "node scripts/check-skill-chains.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
